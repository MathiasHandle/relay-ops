AUTH_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/relay_ops_auth?schema=public"
PORT=3002

#  path to private key .pem file
JWT_PRIVATE_KEY_PATH="./keys/jwt-private.pem"

# claim iss - who issued token
JWT_ISSUER="http://localhost:3002"

# claim aud - who is token issued for
JWT_AUDIENCE="relay-ops-api"