APP_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/relay_ops_app?schema=public"
PORT=3001

# JWKS endpoint of apps/auth (public keys for JWT verification)
AUTH_JWKS_URL="http://localhost:3002/.well-known/jwks.json"

# claim iss - must match JWT_ISSUER in apps/auth
JWT_ISSUER="http://localhost:3002"

# claim aud - must match JWT_AUDIENCE in apps/auth
JWT_AUDIENCE="relay-ops-api"

# RabbitMQ from compose.yaml, vhost `relay-ops`
RABBITMQ_URL="amqp://admin:admin@localhost:5672/relay-ops"