# Copy to .env.test. Used only by Vitest (see vitest.config.ts).

# Must point to a database whose name ends with `_test`; it is reset before every test run.
APP_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/relay_ops_app_test?schema=public"

# Served by the global test setup (throwaway test signing key), not by apps/auth.
AUTH_JWKS_URL="http://127.0.0.1:3902/.well-known/jwks.json"

JWT_ISSUER="http://auth.test"
JWT_AUDIENCE="relay-ops-api-test"

# Not used: tests pass a fake delivery publisher, but env.ts requires it.
RABBITMQ_URL="amqp://guest:guest@localhost:5672/relay-ops-test"
