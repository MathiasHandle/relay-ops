{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "db:generate": {
      "outputs": ["src/generated/**", "prisma/.generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "check:lint": {
      "dependsOn": ["^check:lint"]
    },
    "check:ts": {
      "dependsOn": ["^build", "db:generate"]
    },
    "check:format": {
      "dependsOn": ["db:generate"]
    },
    "fix:lint": {
      "cache": false
    },
    "fix:format": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false
    },
    "test:unit": {
      "dependsOn": ["^build", "db:generate"]
    },
    "test:integration": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    }
  }
}
