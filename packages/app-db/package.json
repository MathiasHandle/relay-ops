{
  "name": "@relay-ops/app-db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check:ts": "tsc --noEmit",
    "check:lint": "eslint .",
    "fix:lint": "eslint . --fix",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset && pnpm db:seed",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "check:format": "prettier --check .",
    "fix:format": "prettier --write ."
  },
  "prettier": "@relay-ops/prettier-config",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@relay-ops/eslint-config": "workspace:*",
    "@relay-ops/prettier-config": "workspace:*",
    "@relay-ops/tsconfig": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
